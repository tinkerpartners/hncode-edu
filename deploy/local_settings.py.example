    "https://mvphsp.com", "https://www.mvphsp.com",
]
# Behind Cloudflare (edge terminates TLS); trust its X-Forwarded-Proto so Django sees HTTPS.
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
DMOJ_SCHEME = "https"
# DEFERRED to cutover window: SITE_DOMAIN + Site(pk=3).domain stay "mvphsp.com" for now.
# Switching them before hncode.edu.vn points at Green would send canonical/email links
# to a domain that still serves Blue.

# --- Email: Amazon SES over SMTP ---
# Port 2587, not 587: DigitalOcean blocks outbound 25/465/587 at its own egress on both
# droplets, which is what killed the previous Gmail SMTP setup. SES also listens on 2465
# (implicit TLS) and 2587 (STARTTLS); both are reachable. See deploy/README.md.
EMAIL_BACKEND = "django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST = "email-smtp.ap-southeast-1.amazonaws.com"
EMAIL_PORT = 2587
EMAIL_USE_TLS = True
EMAIL_USE_SSL = False
EMAIL_HOST_USER = "CHANGEME"  # SES SMTP username (not the IAM access key id)
EMAIL_HOST_PASSWORD = "CHANGEME"  # SES SMTP password, shown once at creation
# Every send is inline -- registration activation, password reset, email change, and the
# problem-author error mail sent from the bridge daemon. Without a timeout a blocked port
# hangs the worker until uwsgi harakiri=60 kills it and the user gets a 504.
EMAIL_TIMEOUT = 10
# Must be an address at an SES-verified identity, or SES rejects the message.
DEFAULT_FROM_EMAIL = "HNCode Online Judge <no-reply@CHANGEME.example.com>"
SERVER_EMAIL = "no-reply@CHANGEME.example.com"
