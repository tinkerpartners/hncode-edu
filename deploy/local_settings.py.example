# Fix Sites framework: default settings.py sets SITE_ID=1 but this DB only has
# Site pk=3. Point to it so Site.objects.get_current() resolves (fixes sitemap,
# outbound email links). Domain set to live mvphsp.com. Added 2026-07-18.
SITE_ID = 3

# --- QA fixes 2026-07-19 (anhcx) ---
# Ace editor: pin a valid version WITH trailing slash. FileEditWidget (admin problem/contest
# add forms) builds the URL via urljoin(ACE_URL, "ace.js"); without a trailing slash urljoin
# drops the version -> .../ajax/libs/ace/ace.js (404). Overrides settings.py:59 (1.1.3, no slash).
ACE_URL = "https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.6/"
# Media: serve from the shared DO Spaces CDN (public-read, verified 200) instead of the local
# nginx /media/ alias, which 403s because s3fs files are root:root 0640 and nginx runs as www-data.
# Matches Blue production (cdn.hncode.edu.vn -> same bucket). MEDIA_ROOT unchanged (uploads still write s3fs).
MEDIA_URL = "https://hncode.edu.vn/media/"  # cdn.hncode.edu.vn CF record broken (Error 1000); serve via main domain->s3fs, CF-cached

# --- HNCode rebrand overrides (2026-07-19) ---
